# Copy to .env and fill in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=example.org,www.example.org
CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org
SITE_URL=https://example.org
TIME_ZONE=Africa/Lagos

# Database and queue
DATABASE_URL=postgres://hospital:hospital@db:5432/hospital
REDIS_URL=redis://redis:6379/0

# Owner admin
ADMIN_PATH=admin
DJANGO_ADMIN_PATH=django-admin-fallback
ADMIN_REQUIRE_2FA=true

# Payments (use test keys until launch)
PAYMENTS_FAKE_MODE=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Brevo SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Haven Medical Relief <no-reply@example.org>

# Newsletter (Brevo contacts API)
BREVO_API_KEY=
BREVO_LIST_ID=

# Spam protection (Cloudflare Turnstile). Leave blank to rely on the honeypot only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Media storage (S3-compatible). Leave blank to store uploads on the server disk.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

SENTRY_DSN=
